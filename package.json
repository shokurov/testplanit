{
    "name": "testplanit-monorepo",
    "version": "1.0.0",
    "description": "TestPlanIt monorepo",
    "author": "Brad DerManouelian",
    "license": "ISC",
    "packageManager": "pnpm@11.5.0",
    "scripts": {
        "changeset": "changeset",
        "changeset:version": "changeset version",
        "changeset:publish": "changeset publish",
        "packages:build": "pnpm --filter \"@testplanit/*\" build",
        "packages:test": "pnpm --filter \"@testplanit/*\" test",
        "build:jira-dc": "pnpm --filter @testplanit/jira-dc-frontend build && mvn -f jira-dc-plugin/pom.xml package"
    },
    "devDependencies": {
        "@changesets/changelog-github": "^0.7.0",
        "@changesets/cli": "^2.31.0",
        "vite": "^8.1.0"
    }
}
