<?xml version="1.0" encoding="UTF-8"?>
<!--
  Spring Scanner activation — REQUIRED, and easy to miss.

  The manifest's `Spring-Context: *` makes the plugin system create a Spring
  context from XML files in META-INF/spring/. WITHOUT this file the context
  is created EMPTY: nothing ever reads META-INF/plugin-components/{component,
  imports}, so no @Named bean and no @ComponentImport is registered, and
  every constructor-injected class fails at runtime with
  NoSuchBeanDefinitionException (Spring, e.g. <servlet> modules) or
  UnsatisfiedDependencyException (Jersey/HK2, REST v2 resources) — while
  zero-argument classes (PingResource) keep working and mask the problem.

  <atlassian-scanner:scan-indexes/> hands context population to the host's
  "Atlassian Spring Scanner Runtime" system plugin, whose namespace handler
  (verified in its bytecode: registerBeanDefinitionParser("scan-indexes"))
  reads the plugin-components indexes generated by our maven plugin at build
  time and registers the beans + component imports.
-->
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:atlassian-scanner="http://www.atlassian.com/schema/atlassian-scanner/2"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
        http://www.springframework.org/schema/beans/spring-beans.xsd
        http://www.atlassian.com/schema/atlassian-scanner/2
        http://www.atlassian.com/schema/atlassian-scanner/2/atlassian-scanner.xsd">
    <atlassian-scanner:scan-indexes/>
</beans>
